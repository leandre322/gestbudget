# =============================================================================
#  .env.example - modele des variables de GestBudget (S26, C1)
#  Aucune valeur reelle ici. Copier en .env.local et remplir.
#  scripts/check-env.mjs verifie avant chaque build que ce fichier declare
#  toute variable lue par le code.
# =============================================================================

# ---- Base de donnees Neon (base gestbudget, jamais neondb) --------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOTE-pooler.REGION.aws.neon.tech/gestbudget?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOTE.REGION.aws.neon.tech/gestbudget?sslmode=require
# Utilisee par le middleware (Edge) pour le rate limiting et par le cron maintenance.
EDGE_DATABASE_URL=postgresql://USER:PASSWORD@HOTE.REGION.aws.neon.tech/gestbudget?sslmode=require

# ---- Authentification ---------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# 32 caracteres minimum : openssl rand -base64 32
NEXTAUTH_SECRET=<a-generer>
# 32 caracteres minimum, aleatoire. Chiffre les secrets 2FA : ne jamais la changer
# sans plan de migration (les 2FA existants deviendraient illisibles).
TOTP_ENCRYPTION_KEY=<a-generer>

# ---- Crons Vercel (Authorization: Bearer) -------------------------------------
# 32 caracteres minimum
CRON_SECRET=<a-generer>

# ---- Origines autorisees (CSRF) -------------------------------------------------
ALLOWED_ORIGINS=https://gestbudget.lawdigitals.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- E-mail Brevo (SMTP) ----------------------------------------------------------
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=<identifiant-smtp-brevo>
BREVO_SMTP_KEY=<cle-smtp-brevo>
BREVO_FROM_EMAIL=<adresse-expediteur>
BREVO_FROM_NAME=GestBudget

# ---- Notifications push (VAPID) : npx web-push generate-vapid-keys ------------
VAPID_PUBLIC_KEY=<cle-publique>
VAPID_PRIVATE_KEY=<cle-privee>
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<cle-publique>

# ---- CSP ------------------------------------------------------------------------
# URL "Security Header" de la cle Sentry csp-reports + &sentry_environment=...
# Obligatoire en Production (check-env). Absente en local : pas de rapports.
CSP_REPORT_URI=
# 1 = CSP bloquante ; toute autre valeur = Report-Only
CSP_ENFORCE=

# ---- Fonctionnalites ------------------------------------------------------------
IMPORT_EXCEL_ENABLED=
